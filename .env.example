# Production-shaped settings for the API. Never commit real values; supply them from a secret store.
ConnectionStrings__DefaultConnection=Host=REPLACE;Port=5432;Database=disputes;Username=REPLACE;Password=REPLACE_ME
ASPNETCORE_ENVIRONMENT=Production
# Session store. Use TLS and a password, e.g. redis.internal:6380,ssl=true,password=REPLACE_ME
ConnectionStrings__Redis=REPLACE:6379
# Session timeouts (defaults shown). The cookie is always Secure outside a local http stack.
#   Session__IdleTimeout=00:05:00
#   Session__AbsoluteLifetime=08:00:00
# Only needed when the portal is served from a different origin than the API. The session cookie
# is SameSite=Strict, so portal and API must share a registrable domain
# (e.g. disputes.example.com and api.disputes.example.com).
Cors__AllowedOrigins__0=https://disputes.example.com
# Logging. Raise a category's level without a rebuild, then restart the container:
#   Logging__LogLevel__DisputePortal=Debug
#   Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command=Information   (every SQL command and its duration)
