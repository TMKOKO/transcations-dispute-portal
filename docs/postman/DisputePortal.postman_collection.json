                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('role is agent', () => pm.expect(pm.response.json().role).to.eql('agent'));",
                  "const match = (pm.response.headers.get('Set-Cookie') || '').match(/dp_session=([^;]+)/);",
                  "pm.test('sets a session cookie', () => pm.expect(match).to.not.be.null);",
                  "save('agentSession', match && match[1]);"
                ]
              }
            }
