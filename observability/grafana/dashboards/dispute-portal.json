    {
      "id": 22,
      "type": "timeseries",
      "title": "Dispute events and read failover",
      "description": "Kafka: events published from the outbox, back-office decisions applied, skipped (duplicate or stale) and dead-lettered, and failed publishes (Kafka down). Replica: reads served from the primary because the replica was unreachable.",
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"api\"} |~ \"Published (DisputeSubmitted|DisputeWithdrawn)\" [$__auto]))",
          "legendFormat": "Published",
          "queryType": "range",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"api\"} |~ \"Applied (UnderReview|RefundIssued|Rejected)\" [$__auto]))",
          "legendFormat": "Decision applied",
          "queryType": "range",
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"api\"} |~ \"already handled|handled concurrently|is stale\" [$__auto]))",
          "legendFormat": "Decision skipped",
          "queryType": "range",
          "editorMode": "code"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"api\"} |= \"dispute-decisions-dlq\" [$__auto]))",
          "legendFormat": "Dead-lettered",
          "queryType": "range",
          "editorMode": "code"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"api\"} |= \"Outbox: publishing\" [$__auto]))",
          "legendFormat": "Publish failed",
          "queryType": "range",
          "editorMode": "code"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"api\"} |= \"Read replica unavailable\" [$__auto]))",
          "legendFormat": "Replica failover",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 2,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": false
          }
        },
        "overrides": []
      },
