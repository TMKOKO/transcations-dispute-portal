    {
      "id": 9,
      "type": "timeseries",
      "title": "Disputes raised per day (last 120 days)",
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "disputes-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "disputes-db"
          },
          "rawSql": "SELECT $__timeGroupAlias(\"CreatedAt\", '1d'), count(*) AS \"Raised\" FROM \"Disputes\" WHERE $__timeFilter(\"CreatedAt\") GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "timeFrom": "120d",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Oldest open disputes",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "disputes-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "disputes-db"
          },
          "rawSql": "SELECT \"DisputeNumber\" AS \"Dispute\", \"Status\", \"Reason\", \"DisputedAmount\" AS \"Amount\", \"CreatedAt\" AS \"Raised\",\n       date_part('day', now() - \"CreatedAt\")::int AS \"Age (days)\"\nFROM \"Disputes\" WHERE \"Status\" IN ('Submitted', 'UnderReview') ORDER BY \"CreatedAt\" LIMIT 10",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Amount"
            },
            "properties": [
              {
                "id": "unit",
                "value": "prefix:R "
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
