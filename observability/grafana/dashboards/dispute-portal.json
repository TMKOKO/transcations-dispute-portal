    {
      "id": 7,
      "type": "piechart",
      "title": "Disputes by status",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "disputes-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "disputes-db"
          },
          "rawSql": "SELECT \"Status\", count(*) AS \"Disputes\" FROM \"Disputes\" GROUP BY 1 ORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "pieType": "donut",
        "displayLabels": [
          "name",
          "value"
        ],
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
