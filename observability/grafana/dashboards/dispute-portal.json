            "uid": "disputes-db"
          },
          "rawSql": "SELECT \"Reason\", count(*) AS \"Disputes\" FROM \"Disputes\" GROUP BY 1 ORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
