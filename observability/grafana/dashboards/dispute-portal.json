            "type": "grafana-postgresql-datasource",
            "uid": "disputes-db"
          },
          "rawSql": "SELECT count(*) AS \"Raised\" FROM \"Disputes\" WHERE $__timeFilter(\"CreatedAt\")",
          "format": "table",
