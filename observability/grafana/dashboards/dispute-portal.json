    {
      "id": 2,
      "type": "stat",
      "title": "Open disputes",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "disputes-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "disputes-db"
          },
          "rawSql": "SELECT count(*) AS \"Open\" FROM \"Disputes\" WHERE \"Status\" IN ('Submitted', 'UnderReview')",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "description": "Submitted or Under review.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Amount under dispute",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "disputes-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "disputes-db"
          },
          "rawSql": "SELECT coalesce(sum(\"DisputedAmount\"), 0) AS \"Amount\" FROM \"Disputes\" WHERE \"Status\" IN ('Submitted', 'UnderReview')",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "description": "Sum of disputed amounts on open disputes.",
      "fieldConfig": {
        "defaults": {
          "unit": "prefix:R ",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
