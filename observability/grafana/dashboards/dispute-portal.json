      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (code) (count_over_time({service=\"api\"} |= \"failed with\" | json code=\"State.Code\" [$__auto]))",
          "legendFormat": "{{code}}",
          "queryType": "range",
          "editorMode": "code"
