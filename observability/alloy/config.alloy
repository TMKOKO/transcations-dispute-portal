// Ships the API container's stdout to Loki. Only the compose service named "api" is collected.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "api" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "api"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "api" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.api.output
  forward_to = [loki.process.api.receiver]
}

// Level and category become labels (few distinct values). Everything else, such as CustomerId,
// Code or TraceId, stays in the line and is parsed at query time with `| json`.
loki.process "api" {
  stage.json {
    expressions = { level = "LogLevel", category = "Category" }
  }

  stage.labels {
    values = { level = "", category = "" }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
