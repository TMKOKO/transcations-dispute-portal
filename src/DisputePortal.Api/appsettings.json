{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "ReadOnlyConnection": "",
    "Redis": ""
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:9094",
    "GroupId": "dispute-portal-api"
  },
  "Session": {
    "IdleTimeout": "00:05:00",
    "AbsoluteLifetime": "08:00:00",
    "CookieName": "dp_session",
    "SecureCookie": true
  },
  "Disputes": {
    "WindowDays": 120
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10,
    "GeneralPermitsPerMinute": 300,
    "TrustForwardedFor": false
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
